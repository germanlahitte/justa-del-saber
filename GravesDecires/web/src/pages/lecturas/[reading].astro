---
// Full Reading page — the "expand to full Reading" exit from the
// contextual drawer (Etapa 3 approval, §4). Same data, more room: full
// thesis, every book_ref with its evidence, every concept, every
// connection.
import Layout from '../../layouts/Layout.astro';
import SourceTag from '../../components/SourceTag.astro';
import { getCollection, getEntry } from 'astro:content';
import { getFirstPageByBookUnit } from '../../lib/bookUnitPage';

export async function getStaticPaths() {
  const readings = await getCollection('readings');
  return readings.map((r) => ({ params: { reading: r.id } }));
}

const { reading: readingParam } = Astro.params;
const reading = await getEntry('readings', readingParam!);
if (!reading) return Astro.redirect('/');

const allConcepts = await getCollection('concepts');
const conceptById = new Map(allConcepts.map((c) => [c.id, c]));
const allReadings = await getCollection('readings');
const readingById = new Map(allReadings.map((r) => [r.id, r]));
// See lib/bookUnitPage.ts: book_refs only know book_unit; resolve each to
// its first real physical page in the corrected paginated reader.
const pageByUnit = await getFirstPageByBookUnit();
---

<Layout title={reading.data.title}>
  <main class="mx-auto max-w-3xl px-6 py-14 sm:px-10">
    <a href="/lecturas" class="font-mono text-xs uppercase tracking-wide text-ink-faint hover:text-ink">
      ← Todas las lecturas
    </a>

    <header class="mt-6 mb-8">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-accent">
        <SourceTag source="FUTURE-ANALYSIS" />
        {reading.data.section} · {reading.data.kind}
      </p>
      <h1 class="mt-3 text-3xl font-normal text-ink">{reading.data.title}</h1>
    </header>

    <p class="prose-book text-lg leading-relaxed text-ink-soft">{reading.data.thesis}</p>

    <section class="mt-10">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-faint">Conceptos</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {reading.data.concept_ids.map((cid) => {
          const c = conceptById.get(cid);
          return c ? (
            <a
              href={`/conceptos/${c.id}`}
              class="rounded-sm border border-rule px-2 py-1 text-sm text-ink-soft hover:border-accent hover:text-accent"
            >
              {c.data.name}
            </a>
          ) : null;
        })}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-faint">
        Unidades del libro referenciadas
      </h2>
      <ul class="mt-3 space-y-3">
        {reading.data.book_refs.map((ref) => (
          <li class="border border-rule p-3">
            <div class="flex items-center justify-between gap-4">
              <a
                href={`/libro/p/${pageByUnit.get(ref.book_unit) ?? 1}`}
                class="font-mono text-sm text-ink hover:text-accent"
              >
                ir al libro (p. {pageByUnit.get(ref.book_unit) ?? '?'}) →
              </a>
              <span class="font-mono text-[10px] uppercase tracking-wide text-ink-faint">
                {ref.relation}
              </span>
            </div>
            {ref.evidence.matched_anchors.length > 0 && (
              <p class="mt-2 font-mono text-xs text-ink-faint">
                anclas: {ref.evidence.matched_anchors.join(', ')}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>

    {reading.data.connections.length > 0 && (
      <section class="mt-10 border-t border-rule pt-6">
        <h2 class="font-mono text-xs uppercase tracking-wider text-ink-faint">
          Lecturas relacionadas
        </h2>
        <ul class="mt-3 space-y-1">
          {reading.data.connections.map((cid) => {
            const r = readingById.get(cid);
            return r ? (
              <li>
                <a
                  href={`/lecturas/${r.id}`}
                  class="text-sm text-ink-soft underline decoration-dotted underline-offset-2 hover:text-accent"
                >
                  {r.data.title}
                </a>
              </li>
            ) : null;
          })}
        </ul>
      </section>
    )}
  </main>
</Layout>
