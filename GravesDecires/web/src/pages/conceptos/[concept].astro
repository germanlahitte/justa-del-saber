---
// CONCEPT DETAIL — Etapa 3 spec: Concept -> Readings -> BookUnits, without
// turning it into a dashboard or a technical graph. `concept-integridad` is
// used as the reference example (9 connected Readings -> 12 distinct
// BookUnits — real, verified connectivity, see WEB-EXPERIENCE audit §A.2).
import Layout from '../../layouts/Layout.astro';
import SourceTag from '../../components/SourceTag.astro';
import { getCollection, getEntry } from 'astro:content';
import { getFirstPageByBookUnit } from '../../lib/bookUnitPage';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((c) => ({ params: { concept: c.id } }));
}

const { concept: conceptParam } = Astro.params;
const concept = await getEntry('concepts', conceptParam!);
if (!concept) return Astro.redirect('/conceptos');

// BookUnit -> its first real physical page (see lib/bookUnitPage.ts):
// links from this Concept into the book must point into the corrected
// paginated reader (/libro/p/[n]), not the retired /libro/[unit] route.
const pageByUnit = await getFirstPageByBookUnit();

const allReadings = await getCollection('readings');
const relatedReadings = allReadings.filter((r) =>
  r.data.concept_ids.includes(concept.id),
);

// Concept -> Readings -> BookUnits: collect the distinct BookUnits reached
// through this concept's Readings, keeping which Reading brought each unit
// (a unit can arrive via more than one Reading — shown, not collapsed).
const unitsByReading = relatedReadings.map((r) => ({
  reading: r,
  units: [...new Set(r.data.book_refs.map((ref) => ref.book_unit))],
}));
const allUnits = [...new Set(unitsByReading.flatMap((x) => x.units))].sort((a, b) => a - b);
---

<Layout title={concept.data.name}>
  <main class="mx-auto max-w-3xl px-6 py-14 sm:px-10">
    <a href="/conceptos" class="font-mono text-xs uppercase tracking-wide text-ink-faint hover:text-ink">
      ← Todos los conceptos
    </a>

    <header class="mt-6 mb-8">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-accent">
        <SourceTag source="FUTURE-ANALYSIS" />
        Concepto
      </p>
      <h1 class="mt-3 text-3xl font-normal text-ink">{concept.data.name}</h1>
      <p class="prose-book mt-3 text-base leading-relaxed text-ink-soft">{concept.data.definition}</p>
      {concept.data.key_distinction && (
        <p class="prose-book mt-2 text-sm text-ink-faint italic">{concept.data.key_distinction}</p>
      )}
      {concept.data.formula && (
        <p class="prose-book mt-3 border-l-2 border-accent pl-3 text-sm text-ink">
          {concept.data.formula}
        </p>
      )}
    </header>

    {Object.keys(concept.data.relations).length > 0 && (
      <section class="mb-10 border-t border-rule pt-6">
        <h2 class="font-mono text-xs uppercase tracking-wider text-ink-faint">Relaciones directas</h2>
        <dl class="mt-3 space-y-2">
          {Object.entries(concept.data.relations).map(([relation, targets]) => (
            <div class="flex flex-wrap items-baseline gap-2 text-sm">
              <dt class="font-mono text-xs text-ink-faint">{relation}</dt>
              <dd class="flex flex-wrap gap-2">
                {targets.map((t) => (
                  <span class="rounded-sm border border-rule px-1.5 py-0.5 text-ink-soft">{t}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {/* Concept -> Readings */}
    <section class="mb-10 border-t border-rule pt-6">
      <h2 class="font-mono text-xs uppercase tracking-wider text-ink-faint">
        Lecturas que usan este concepto ({relatedReadings.length})
      </h2>
      <ul class="mt-3 space-y-4">
        {unitsByReading.map(({ reading, units }) => (
          <li class="border border-rule p-4">
            <a href={`/lecturas/${reading.id}`} class="text-sm font-medium text-ink hover:text-accent">
              {reading.data.title}
            </a>
            <p class="prose-book mt-1 text-xs text-ink-soft">{reading.data.thesis}</p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <span class="font-mono text-[10px] uppercase tracking-wide text-ink-faint">→ unidades:</span>
              {units.map((u) => (
                <a
                  href={`/libro/p/${pageByUnit.get(u) ?? 1}`}
                  class="rounded-sm border border-rule px-1.5 py-0.5 font-mono text-[11px] text-ink-soft hover:border-accent hover:text-accent"
                  title={`unidad ${u}`}
                >
                  p.{pageByUnit.get(u) ?? '?'}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* Readings -> BookUnits, collapsed view: the full reach of this Concept
        into the book, as a simple list (no graph). */}
    {allUnits.length > 0 && (
      <section class="border-t border-rule pt-6">
        <h2 class="font-mono text-xs uppercase tracking-wider text-ink-faint">
          Alcance en el libro: {allUnits.length} unidades distintas
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {allUnits.map((u) => (
            <a
              href={`/libro/p/${pageByUnit.get(u) ?? 1}`}
              class="rounded-sm border border-rule px-2 py-1 font-mono text-xs text-ink-soft hover:border-accent hover:text-accent"
              title={`unidad ${u}`}
            >
              p.{pageByUnit.get(u) ?? '?'}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
