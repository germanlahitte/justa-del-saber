---
// Traceability principle (Etapa 1 / PROJECT-BRIEF §21 / Etapa 1.5): never
// let generated or interpretive content blend silently with the book. This
// tiny tag is used everywhere content is rendered so the origin of every
// piece of text on screen is always explicit and machine-derived (it's a
// prop, not a design flourish), never inferred by the reader.
type Source = 'BOOK' | 'ASSET' | 'EDITORIAL' | 'FUTURE-ANALYSIS';

interface Props {
  source: Source;
}
const { source } = Astro.props;

const labels: Record<Source, string> = {
  BOOK: 'Libro — texto original',
  ASSET: 'Recurso original del libro',
  EDITORIAL: 'Metadata editorial',
  'FUTURE-ANALYSIS': 'Lectura / capa interpretativa',
};

const styles: Record<Source, string> = {
  BOOK: 'border-ink-faint text-ink-soft',
  ASSET: 'border-ink-faint text-ink-soft',
  EDITORIAL: 'border-ink-faint text-ink-faint',
  'FUTURE-ANALYSIS': 'border-accent text-accent',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-sm border px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider',
    styles[source],
  ]}
  title={labels[source]}
>
  {source}
</span>
